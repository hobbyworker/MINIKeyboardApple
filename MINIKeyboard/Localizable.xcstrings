      }
    },
    "Modifiers alone make the key a modifier key, so they can’t go with other presses." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Sondertasten machen die Taste zur Sondertaste, daher passen sie nicht zu anderen Tastendrücken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo modificadores convierten la tecla en una tecla de modificación, así que no pueden ir con otras pulsaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des modificateurs seuls font de la touche une touche de modification : ils ne peuvent pas aller avec d’autres frappes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya pengubah menjadikan tombol sebagai tombol pengubah, jadi tidak bisa digabung dengan tekanan lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo i modificatori rendono il tasto un tasto modificatore, quindi non possono stare con altre pressioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修飾キーのみにするとそのキーは修飾キーになるため、ほかの入力と一緒には追加できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보조 키만 넣으면 그 키가 보조 키가 되므로, 다른 입력과 함께 넣을 수 없습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Same modyfikatory zmieniają klawisz w klawisz modyfikujący, więc nie mogą iść z innymi naciśnięciami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só modificadoras tornam a tecla uma tecla modificadora, então não podem ir com outros toques."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ phím bổ trợ sẽ biến phím thành phím bổ trợ, nên không thể đi cùng các lần nhấn khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅修饰键会使该按键成为修饰键，因此不能与其他输入一起添加。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅變更鍵會使該按鍵成為變更鍵，因此不能與其他輸入一起加入。"
          }
        }
      }
    },
    "Modifiers apply to the next key." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sondertasten gelten für die nächste Taste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las teclas de modificación se aplican a la siguiente tecla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les touches de modification s’appliquent à la touche suivante."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tombol pengubah berlaku untuk tombol berikutnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tasti modificatori valgono per il tasto successivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修飾キーは次に押すキーと組み合わされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보조 키는 다음에 누르는 키에 붙습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klawisze modyfikujące dotyczą następnego klawisza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As teclas modificadoras valem para a próxima tecla."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phím bổ trợ áp dụng cho phím bấm tiếp theo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修饰键会与下一个按下的键组合。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "變更鍵會與下一個按下的鍵組合。"
          }
        }
      }
    },
    "Modifiers apply to the next key. A key holds up to %lld presses, each modifier counting as one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sondertasten gelten für die nächste Taste. Eine Taste fasst bis zu %lld Tastendrücke, jede Sondertaste mitgezählt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las teclas de modificación se aplican a la siguiente tecla. Una tecla admite hasta %lld pulsaciones, contando cada modificador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les touches de modification s’appliquent à la touche suivante. Une touche peut contenir jusqu’à %lld frappes, chaque modificateur compris."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tombol pengubah berlaku untuk tombol berikutnya. Satu tombol dapat menampung hingga %lld tekanan, termasuk setiap pengubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tasti modificatori valgono per il tasto successivo. Un tasto può contenere fino a %lld pressioni, modificatori compresi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修飾キーは次に押すキーと組み合わされます。1つのキーに入力は修飾キーと合わせて%lld個まで追加できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보조 키는 다음에 누르는 키에 붙습니다. 키 하나에 입력은 보조 키까지 합쳐 %lld개까지 넣을 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klawisze modyfikujące dotyczą następnego klawisza. Klawisz może zawierać do %lld naciśnięć, licząc każdy modyfikator."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As teclas modificadoras valem para a próxima tecla. Uma tecla comporta até %lld toques, contando cada modificadora."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phím bổ trợ áp dụng cho phím bấm tiếp theo. Mỗi phím chứa tối đa %lld lần nhấn, tính cả từng phím bổ trợ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修饰键会与下一个按下的键组合。每个按键的输入和修饰键合计最多可添加 %lld 个。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "變更鍵會與下一個按下的鍵組合。每個按鍵的輸入和變更鍵合計最多可加入 %lld 個。"
          }
        }
      }
    },
