    "The last key pressed keeps blinking, in a new color with each press." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die zuletzt gedrückte Taste blinkt weiter, bei jedem Drücken in einer neuen Farbe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La última tecla pulsada sigue parpadeando, con un color nuevo en cada pulsación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dernière touche enfoncée continue de clignoter, dans une nouvelle couleur à chaque pression."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tombol yang terakhir ditekan terus berkedip, dengan warna baru setiap kali ditekan."
