    "This keyboard’s firmware (type %lld) hasn’t been tested yet. If keys read or save wrong, please report it with the device log." : {
      "comment" : "Notice when a keyboard identifies with a type byte the app has not seen. %lld is that type.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Firmware dieser Tastatur (Typ %lld) wurde noch nicht getestet. Werden Tasten falsch gelesen oder gesichert, melde es bitte mit dem Geräteprotokoll."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El firmware de este teclado (tipo %lld) aún no se ha probado. Si las teclas se leen o se guardan mal, avísanos con el registro del dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le programme interne de ce clavier (type %lld) n’a pas encore été testé. Si les touches sont mal lues ou mal enregistrées, signalez-le avec le journal de l’appareil."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firmware papan ketik ini (jenis %lld) belum pernah diuji. Jika tombol terbaca atau tersimpan dengan salah, laporkan bersama log perangkat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il firmware di questa tastiera (tipo %lld) non è ancora stato provato. Se i tasti vengono letti o salvati in modo errato, segnalalo con il registro dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このキーボードのファームウェア（種類 %lld）はまだテストしていません。キーの読み込みや保存がおかしい場合は、デバイスログを添えてお知らせください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 키보드의 펌웨어(종류 %lld)는 아직 시험해 보지 못했습니다. 키를 읽거나 저장한 것이 이상하면 장치 기록과 함께 알려 주세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oprogramowanie sprzętowe tej klawiatury (typ %lld) nie zostało jeszcze przetestowane. Jeśli klawisze są źle odczytywane lub zachowywane, zgłoś to razem z dziennikiem urządzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O firmware deste teclado (tipo %lld) ainda não foi testado. Se as teclas forem lidas ou salvas de forma errada, informe-nos com o registro do dispositivo."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chương trình cơ sở của bàn phím này (loại %lld) chưa được kiểm thử. Nếu phím được đọc hoặc lưu sai, hãy báo cho chúng tôi kèm nhật ký thiết bị."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此键盘的固件（类型 %lld）尚未经过测试。如果按键读取或保存有误，请附上设备日志告诉我们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此鍵盤的韌體（類型 %lld）尚未經過測試。如果按鍵讀取或儲存有誤，請附上裝置日誌告訴我們。"
          }
        }
      }
    },
