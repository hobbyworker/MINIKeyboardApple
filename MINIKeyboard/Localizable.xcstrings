    "Some keys or knobs couldn’t be read. They’re shown as before." : {
      "comment" : "Notice after reading: the keyboard stopped answering before every key and knob was read.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Tasten oder Drehknöpfe ließen sich nicht lesen. Sie werden wie zuvor angezeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se han podido leer algunas teclas o botones giratorios. Se muestran como antes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines touches ou certains boutons rotatifs n’ont pas pu être lus. Ils sont affichés comme avant."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beberapa tombol atau kenop tidak dapat dibaca. Semuanya ditampilkan seperti sebelumnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile leggere alcuni tasti o manopole. Sono mostrati come prima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一部のキーやノブを読み込めませんでした。それらは以前のまま表示しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일부 키와 노브를 읽지 못했습니다. 그 자리는 전과 같이 보입니다."
          }
