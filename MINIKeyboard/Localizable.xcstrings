        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A iluminação é definida por camada, então não é preciso selecionar uma tecla."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
