<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Hand-written keys only — the rest is generated (GENERATE_INFOPLIST_FILE = YES) and merged
		on top. Xcode's INFOPLIST_KEY_* covers a fixed list of Apple keys and drops the others
		without a word, so these live here.

		The values come from Signing.xcconfig (BRAND_*); the source carries none. Updates need
		both the feed and its key — with either empty they are off. An empty copyright hides
		that line.

		SUFeedURL is frozen once a build ships: the feed's own address is baked into the app.
	-->
	<key>SUFeedURL</key>
	<string>$(BRAND_FEED_URL)</string>

	<!-- EdDSA public key — Sparkle verifies every update against it. -->
	<key>SUPublicEDKey</key>
	<string>$(BRAND_FEED_PUBLIC_KEY)</string>

	<key>BrandCopyright</key>
	<string>$(BRAND_COPYRIGHT)</string>
</dict>
</plist>
