{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ needs to relaunch to apply the change." : {
      "comment" : "Alert after the language changes. %@ is the app name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ muss neu gestartet werden, um die Änderung zu übernehmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ debe reiniciarse para aplicar el cambio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ doit être relancé pour appliquer ce changement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ perlu diluncurkan ulang untuk menerapkan perubahan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ deve essere riaperto per applicare la modifica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変更を適用するには、%@を再起動する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "변경 사항을 적용하려면 %@를 다시 실행해야 합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby zastosować zmianę, %@ musi zostać uruchomiony ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O %@ precisa ser reaberto para aplicar a alteração."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ cần khởi chạy lại để áp dụng thay đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要应用更改，需要重启 %@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要套用變更，需要重新啟動 %@。"
          }
        }
      }
    },
    "%@ uses the following open source packages. Below is the original license each package publishes in its source repository." : {
      "comment" : "Opening line of the licenses sheet. %@ is the app name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ verwendet die folgenden Open-Source-Pakete. Unten steht der Original-Lizenztext, den jedes Paket in seinem Quellcode-Repository veröffentlicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ utiliza los siguientes paquetes de código abierto. A continuación aparece el texto original de la licencia que cada paquete publica en su repositorio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ utilise les paquets open source suivants. Ci-dessous figure le texte original de la licence que chaque paquet publie dans son dépôt source."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ memakai paket sumber terbuka berikut. Di bawah ini adalah teks asli lisensi yang diterbitkan setiap paket di repositori sumbernya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ utilizza i seguenti pacchetti open source. Di seguito il testo originale della licenza che ogni pacchetto pubblica nel proprio repository."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は次のオープンソースパッケージを使用しています。以下は、各パッケージがソースリポジトリで公開しているライセンスの原文です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@는 다음 오픈소스 패키지를 사용합니다. 아래는 각 패키지가 소스 저장소에 게시한 라이선스 원문입니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ korzysta z następujących pakietów open source. Poniżej znajduje się oryginalna treść licencji, którą każdy pakiet publikuje w swoim repozytorium."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O %@ usa os seguintes pacotes de código aberto. Abaixo está o texto original da licença que cada pacote publica em seu repositório."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sử dụng các gói nguồn mở sau. Bên dưới là nguyên văn giấy phép mà mỗi gói công bố trong kho mã nguồn của mình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 使用了以下开源软件包。下面是各软件包在其源代码仓库中公布的许可证原文。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 使用了以下開放原始碼套件。以下是各套件在其原始碼儲存庫中公布的授權條款原文。"
          }
        }
      }
    },
