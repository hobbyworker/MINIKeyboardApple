    "Each press can wait before it is sent. Give the key its presses on the Keys page first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Tastendruck kann warten, bevor er gesendet wird. Gib der Taste zuerst auf der Seite „Tasten“ ihre Tastendrücke."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada pulsación puede esperar antes de enviarse. Primero, añade las pulsaciones a la tecla en la página “Teclas”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque frappe peut attendre avant d’être envoyée. Ajoutez d’abord les frappes de la touche sur la page « Touches »."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap tekanan dapat menunggu sebelum dikirim. Tambahkan dulu tekanan tombol di halaman Tombol."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni pressione può attendere prima di essere inviata. Aggiungi prima le pressioni del tasto nella pagina “Tasti”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入力ごとに送信前の待ち時間を設定できます。先に「キー」ページでキーに入力を追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "입력마다 보내기 전에 기다리게 할 수 있습니다. 먼저 키 쪽에서 입력을 넣으세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każde naciśnięcie może zaczekać przed wysłaniem. Najpierw dodaj naciśnięcia klawisza na stronie „Klawisze”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada toque pode esperar antes de ser enviado. Primeiro, adicione os toques da tecla na página “Teclas”."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi lần nhấn có thể chờ trước khi được gửi. Hãy thêm các lần nhấn cho phím ở trang Phím trước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个输入在发送前都可以等待。请先在“按键”页给按键添加输入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個輸入在傳送前都可以等待。請先在「按鍵」頁為按鍵加入輸入。"
          }
        }
      }
    },
