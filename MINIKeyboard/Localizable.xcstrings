    "A key holds up to %lld presses." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Taste fasst bis zu %lld Tastendrücke."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una tecla admite hasta %lld pulsaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une touche peut contenir jusqu’à %lld frappes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satu tombol dapat menampung hingga %lld tekanan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un tasto può contenere fino a %lld pressioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1つのキーに入力は%lld個まで追加できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키 하나에 입력은 %lld개까지 넣을 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klawisz może zawierać do %lld naciśnięć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma tecla comporta até %lld toques."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi phím chứa tối đa %lld lần nhấn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个按键最多可添加 %lld 个输入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個按鍵最多可加入 %lld 個輸入。"
          }
        }
      }
    },
    "A light runs across the keys in order, in a new color each round." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Licht läuft der Reihe nach über die Tasten, jede Runde in einer neuen Farbe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una luz recorre las teclas en orden, con un color nuevo en cada vuelta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une lumière parcourt les touches dans l’ordre, dans une nouvelle couleur à chaque tour."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cahaya berjalan melintasi tombol secara berurutan, dengan warna baru setiap putaran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una luce scorre sui tasti in ordine, con un colore nuovo a ogni giro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光がキーを順に流れ、一周するたびに色が変わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "불빛이 키를 차례로 지나가고, 한 바퀴마다 색이 바뀝니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Światło przebiega po klawiszach po kolei, w każdym okrążeniu w nowym kolorze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma luz percorre as teclas em ordem, com uma nova cor a cada volta."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ánh sáng chạy lần lượt qua các phím, mỗi vòng lại đổi màu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "灯光依次流过各键，每转一圈换一种颜色。"
          }
        },
        "zh-Hant" : {
