    "This isn't a real keyboard. Nothing you save here is written to any keyboard." : {
      "comment" : "The bar across the window while a simulated keyboard is in use.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist keine echte Tastatur. Was du hier sicherst, wird auf keine Tastatur geschrieben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No es un teclado real. Lo que guardes aquí no se escribe en ningún teclado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce n’est pas un vrai clavier. Ce que vous enregistrez ici n’est écrit sur aucun clavier."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini bukan papan ketik sungguhan. Apa pun yang Anda simpan di sini tidak ditulis ke papan ketik mana pun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è una tastiera reale. Ciò che salvi qui non viene scritto su nessuna tastiera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実際のキーボードではありません。ここで保存しても、どのキーボードにも書き込みません。"
