    "Not known — this keyboard doesn’t tell what its keys do. Whatever you set here is written when you save." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unbekannt – diese Tastatur verrät nicht, was ihre Tasten tun. Was du hier festlegst, wird beim Sichern geschrieben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desconocido: este teclado no indica qué hacen sus teclas. Lo que configures aquí se escribe al guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inconnu : ce clavier n’indique pas ce que font ses touches. Ce que vous réglez ici est écrit à l’enregistrement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak diketahui — papan ketik ini tidak memberi tahu fungsi tombolnya. Apa pun yang Anda atur di sini ditulis saat disimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sconosciuto: questa tastiera non indica cosa fanno i suoi tasti. Ciò che imposti qui viene scritto quando salvi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不明 — このキーボードはキーの動作を教えてくれません。ここで設定した内容は保存時に書き込まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알 수 없음 — 이 키보드는 키에 무엇이 들어 있는지 알려 주지 않습니다. 여기서 정한 것은 저장할 때 키보드에 씁니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieznane — ta klawiatura nie podaje, co robią jej klawisze. To, co tu ustawisz, zostanie zapisane przy zachowywaniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desconhecido — este teclado não informa o que suas teclas fazem. O que você definir aqui é gravado ao salvar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không rõ — bàn phím này không cho biết các phím làm gì. Những gì bạn đặt ở đây sẽ được ghi khi lưu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
