        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ultimo tasto premuto continua a lampeggiare, con un colore nuovo a ogni pressione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最後に押したキーが点滅し続け、押すたびに色が変わります。"
