    "Saved, but some keys or knobs read back differently. Those changes stay unsaved." : {
      "comment" : "Notice after saving: reading the saved layers back found keys or knobs that differ from what was written.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesichert, doch beim erneuten Lesen weichen einige Tasten oder Drehknöpfe ab. Diese Änderungen bleiben ungesichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardado, pero al volver a leerlo algunas teclas o botones giratorios son distintos. Esos cambios siguen sin guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistré, mais à la relecture certaines touches ou certains boutons rotatifs diffèrent. Ces modifications restent non enregistrées."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disimpan, tetapi saat dibaca ulang beberapa tombol atau kenop berbeda. Perubahan itu tetap belum disimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvato, ma rileggendo alcuni tasti o manopole risultano diversi. Queste modifiche restano non salvate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存しましたが、読み込み直すと一部のキーやノブが異なります。その変更は保存していないものとして残します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장했지만 다시 읽어 보니 일부 키와 노브가 다릅니다. 그 변경 사항은 저장하지 않은 것으로 남겨 둡니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachowano, ale po ponownym odczycie niektóre klawisze lub pokrętła się różnią. Te zmiany pozostają niezachowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvo, mas ao ler de novo algumas teclas ou botões giratórios estão diferentes. Essas alterações continuam não salvas."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã lưu, nhưng khi đọc lại, một số phím hoặc núm xoay khác đi. Các thay đổi đó vẫn được giữ là chưa lưu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已保存，但重新读取后部分按键或旋钮不一致。这些更改仍保留为未保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
