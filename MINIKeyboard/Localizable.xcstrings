    "Lighting is set per layer; no key selection is needed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Beleuchtung wird pro Ebene eingestellt, daher musst du keine Taste auswählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La iluminación se configura por capa, así que no hace falta seleccionar ninguna tecla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’éclairage se règle par couche, il n’est donc pas nécessaire de sélectionner une touche."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pencahayaan diatur per lapisan, jadi tidak perlu memilih tombol."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’illuminazione si imposta per livello, quindi non serve selezionare un tasto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライティングはレイヤーごとに設定されるため、キーを選択する必要はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
