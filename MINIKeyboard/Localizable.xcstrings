          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle die Form, die zur Tastatur passt, und drehe sie dann so, wie die Tastatur vor dir liegt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige la forma que coincida con el teclado y gírala para que quede como el teclado delante de ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez la forme qui correspond au clavier, puis faites-la pivoter pour qu’elle soit orientée comme le clavier devant vous."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih bentuk yang sesuai dengan papan ketik, lalu putar hingga sama dengan posisinya di depan Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli la forma corrispondente alla tastiera, poi ruotala come la tastiera è posizionata davanti a te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーボードと同じ形を選んでから、手前に置いた向きと同じになるように回転してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키보드와 같은 모양을 고른 다음, 앞에 놓인 방향에 맞게 돌리세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz kształt pasujący do klawiatury, a potem obróć go tak, jak klawiatura leży przed tobą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha a forma correspondente ao teclado e gire-a para ficar como o teclado está na sua frente."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy chọn hình dạng giống với bàn phím, rồi xoay cho khớp với hướng đặt bàn phím trước mặt bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请选择与键盘相同的形状，再将其旋转到与摆放方向一致。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請選擇與鍵盤相同的形狀，再將它旋轉成與擺放方向一致。"
          }
        }
      }
    },
