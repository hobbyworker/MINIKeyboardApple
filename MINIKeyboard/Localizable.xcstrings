        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To nie jest prawdziwa klawiatura. To, co tu zachowasz, nie zostanie zapisane na żadnej klawiaturze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este não é um teclado de verdade. O que você salvar aqui não é gravado em nenhum teclado."
